<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>总开关</string>
			<key>footerText</key>
			<string>拦截「跨 App 跳转」并弹出应用选择面板。修改后立即生效，无需注销。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>启用插件</string>
			<key>key</key><string>Enabled</string>
			<key>defaults</key><string>com.lvxl524.splitjump</string>
			<key>default</key><true/>
			<key>PostNotification</key><string>com.lvxl524.splitjump/ReloadPrefs</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>拦截规则</string>
			<key>footerText</key>
			<string>使用教程：
1. 拦截应用：设置你需要被拦截唤起的 App 本体（如：微信），需要选择从 AppStore 安装的官方正版应用；另外要注意：已做过注入 / 多开的 App 不要设为拦截目标。
2. 列表应用显示：一般设置多开应用，设置后触发拦截弹窗，弹窗内显示你选择的 App（如：微信分身1、分身2）。
3. 放行黑名单：当黑名单内的 App 尝试唤起被拦截目标时，直接放行，不弹窗。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>拦截规则管理（添加 / 编辑 / 删除）</string>
			<key>action</key><string>editRules</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>放行黑名单</string>
			<key>footerText</key>
			<string>当以下应用发起跳转时，直接放行且不触发弹窗。com.apple.springboard 始终保留，避免桌面点图标也弹窗。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>选择放行黑名单</string>
			<key>action</key><string>editBlacklist</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>行为</string>
			<key>footerText</key>
			<string>开启后仅拦截带 URL 的跳转（支付、授权、分享等），普通打开不拦截。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>仅拦截带 URL 的跳转</string>
			<key>key</key><string>URLOnly</string>
			<key>defaults</key><string>com.lvxl524.splitjump</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>com.lvxl524.splitjump/ReloadPrefs</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>高级</string>
			<key>footerText</key>
			<string>提早拦截：装有分屏 / 浮窗类插件（如 Stheno）且面板不出现时再开启，开启后请自行验证各类跳转。
写入调试日志：输出到 /var/mobile/Library/Logs/SplitJump.log。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>提早拦截</string>
			<key>key</key><string>EarlyHook</string>
			<key>defaults</key><string>com.lvxl524.splitjump</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>com.lvxl524.splitjump/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>写入调试日志</string>
			<key>key</key><string>DebugLog</string>
			<key>defaults</key><string>com.lvxl524.splitjump</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>com.lvxl524.splitjump/ReloadPrefs</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string></string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>清空全部规则</string>
			<key>action</key><string>clearAllRules</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>导出日志</string>
			<key>action</key><string>exportLogs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>注销 SpringBoard（Respring）</string>
			<key>action</key><string>respringNow</string>
		</dict>

	</array>
	<key>title</key>
	<string>SplitJump</string>
</dict>
</plist>
